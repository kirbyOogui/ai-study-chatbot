# サーバー専用の環境変数（Vercel の Project Settings > Environment Variables に設定してください）
# 先頭に VITE_ を付けないこと。付けるとクライアント(ブラウザ)側に露出してしまいます。
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx

# Difyクラウド版の場合はデフォルトのままでOK。セルフホスト版の場合は自分のエンドポイントに変更してください
DIFY_API_BASE_URL=https://api.dify.ai/v1

# ローカルで api/dify-chat.ts を含めて動作確認したい場合は `vercel dev` を使ってください
# (単なる `npm run dev` は Vite の静的サーバーのみで、Serverless Function は動きません)
